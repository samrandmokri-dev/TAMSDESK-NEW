<Window x:Class="TamsDesk.Client.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TAMSDESK — remote session" Height="700" Width="1100"
        Background="Black" WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Image x:Name="Screen" Stretch="Uniform"
               MouseMove="Screen_MouseMove"
               MouseDown="Screen_MouseDown"
               MouseUp="Screen_MouseUp"
               MouseWheel="Screen_MouseWheel"/>
        <Border x:Name="Overlay" Background="#CC000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="White"
                           FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

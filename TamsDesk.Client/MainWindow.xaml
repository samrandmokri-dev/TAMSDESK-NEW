<Window x:Class="TamsDesk.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TAMSDESK" Height="560" Width="760"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="TAMS" Foreground="{StaticResource Text}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="DESK" Foreground="{StaticResource Accent}" FontSize="26" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- HOST PANEL -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="This computer" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Share these so someone can control this screen." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>

                    <TextBlock Text="Your ID" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBox x:Name="HostIdBox" IsReadOnly="True" FontSize="22" FontWeight="Bold" Margin="0,2,0,12" Text="— — —"/>

                    <TextBlock Text="Session password" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBox x:Name="HostPwBox" IsReadOnly="True" FontSize="22" FontWeight="Bold" Margin="0,2,0,16" Text="— — —"/>

                    <Button x:Name="HostToggleBtn" Content="Allow incoming connections" Click="HostToggle_Click"/>
                    <TextBlock x:Name="HostStatus" Text="Offline" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONTROLLER PANEL -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Remote computer" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Enter the ID and password of the computer you want to control." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>

                    <TextBlock Text="Remote ID" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBox x:Name="PeerIdBox" FontSize="18" Margin="0,2,0,12"/>

                    <TextBlock Text="Password" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBox x:Name="PeerPwBox" FontSize="18" Margin="0,2,0,16"/>

                    <Button Content="Connect" Click="Connect_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Relay server" Foreground="{StaticResource Muted}" FontSize="12"/>
            <TextBox x:Name="RelayBox" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
